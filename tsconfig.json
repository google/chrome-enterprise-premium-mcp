{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./",
    "allowJs": false,
    "checkJs": false
  },
  "include": ["lib/**/*", "tools/**/*", "prompts/**/*", "mcp-server.ts", "bin/**/*"],
  "exclude": ["node_modules", "dist"]
}
